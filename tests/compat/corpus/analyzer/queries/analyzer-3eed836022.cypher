MATCH (a {id:$id, graph_owner:$graph_owner})-[r]->(t:TABLE {graph_owner:$graph_owner}) WHERE type(r) IN $rels AND t.id IS NOT NULL RETURN t.id AS id, elementId(t) AS eid, coalesce(t.name,'') AS name, coalesce(t.logical_name,'') AS logical_name, CASE WHEN trim(coalesce(t.description,'')) <> '' THEN t.description ELSE coalesce(t.analyzed_description,'') END AS summary, type(r) AS relation
