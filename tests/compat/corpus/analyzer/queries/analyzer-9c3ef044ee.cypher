MATCH (x {id:$id, graph_owner:$graph_owner})-[hr:HAS_RULE]->(r:RULE {graph_owner:$graph_owner}) OPTIONAL MATCH (r)-[:HAS_EXAMPLE]->(e:EXAMPLE {graph_owner:$graph_owner}) OPTIONAL MATCH (e)-[at:AFFECTS_TABLE]->(t:TABLE {graph_owner:$graph_owner}) RETURN r.id AS rule_id, hr.occurrence_id AS occurrence_id,   coalesce(hr.ordinal,0) AS ordinal, r.statement AS statement, e.id AS example_id,   e.given AS given, e.when_ AS when_, e.then_ AS then_, t.name AS table_name, at.op AS op
