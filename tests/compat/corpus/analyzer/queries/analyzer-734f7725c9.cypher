MATCH (t:TABLE {id:$id, graph_owner:$graph_owner})-[:HAS_COLUMN]->(c:COLUMN {graph_owner:$graph_owner}) RETURN c.id AS id, c.name AS name, coalesce(c.dtype,'') AS dtype, coalesce(c.is_primary_key,false) AS is_primary_key, coalesce(c.logical_name,'') AS logical_name, CASE WHEN trim(coalesce(c.description,'')) <> '' THEN c.description WHEN trim(coalesce(c.analyzed_description,'')) <> '' THEN c.analyzed_description ELSE '' END AS description ORDER BY c.id
