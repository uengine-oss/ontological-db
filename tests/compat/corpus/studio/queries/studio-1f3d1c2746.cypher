MATCH (c:_OntologyClass {class_name: $class_name})<-[:HAS_CLASS]-(m:_OntologyModel {schema_id: $schema_id}) MATCH (c)-[:HAS_BINDING]->(b:_OntologyBinding) CREATE (h:_OntologyBehavior {behavior_name: $behavior_name}) SET h.behavior_type = $behavior_type,     h.class_name = $class_name, h.description = $description,     h.parameters = $parameters, h.sql_template = $sql_template,     h.output_columns = $output_columns, h.result_kind = $result_kind,     h.max_rows = $max_rows, h.golden_question = $golden_question, h.synonyms = $synonyms, h.certified = $certified, h.certified_by = $certified_by, h.certified_at = $certified_at CREATE (b)-[:HAS_BEHAVIOR]->(h)
