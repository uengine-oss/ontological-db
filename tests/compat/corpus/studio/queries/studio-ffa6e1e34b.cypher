MATCH (m:_OntologyModel {schema_id: $schema_id})-[:HAS_CLASS]->(c:_OntologyClass {class_name: $class_name}) CREATE (a:_OntologyBehavior {behavior_name: $behavior_name}) SET a.behavior_type = $behavior_type, a.class_name = $class_name,     a.schema_id = $schema_id, a.description = $description,     a.parameters = $parameters, a.key_property = $key_property,     a.system = $system, a.operation_id = $operation_id,     a.arg_mapping = $arg_mapping, a.effect = $effect,     a.confirm_threshold = $confirm_threshold, a.max_targets = $max_targets,     a.policy = $policy, a.compensate = $compensate,     a.writeback_property = $writeback_property, a.version = $version,     a.steps = $steps CREATE (c)-[:HAS_ACTION]->(a)
