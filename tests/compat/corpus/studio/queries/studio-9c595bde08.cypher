MATCH (m:_OntologyModel)-[:HAS_CLASS]->(c:_OntologyClass) WHERE $schema_name IS NULL OR m.name = $schema_name OPTIONAL MATCH (c)-[:HAS_BINDING]->(b:_OntologyBinding) OPTIONAL MATCH (b)-[:HAS_BEHAVIOR]->(h:_OntologyBehavior) RETURN m.name AS schema_name, c.class_name AS class_name,        c.description AS description, c.binding_kind AS binding_kind,        c.properties AS properties, c.synonyms AS synonyms, c.certified AS certified,        b.datasource AS datasource, b.source_schema AS source_schema,        b.table_name AS table_name, b.key_columns AS key_columns,        b.virtual_node AS virtual_node, b.column_map AS column_map,        b.base_conditions AS base_conditions, count(h) AS behavior_count ORDER BY c.class_name
