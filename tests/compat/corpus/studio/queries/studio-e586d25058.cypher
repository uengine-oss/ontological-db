MATCH (m:_OntologyModel {schema_id: $schema_id})-[:HAS_CLASS]->(c:_OntologyClass {class_name: $class_name}) CREATE (b:_OntologyBinding {class_name: $class_name}) SET b.datasource = $datasource, b.source_schema = $source_schema,     b.table_name = $table_name, b.extra_tables = $extra_tables,     b.key_columns = $key_columns, b.column_map = $column_map,     b.base_conditions = $base_conditions, b.label_property = $label_property,     b.default_limit = $default_limit, b.virtual_node = $virtual_node CREATE (c)-[:HAS_BINDING]->(b)
