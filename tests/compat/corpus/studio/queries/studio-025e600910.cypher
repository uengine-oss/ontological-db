MATCH (m:_OntologyModel {schema_id: $schema_id}) UNWIND $rows AS row CREATE (c:_OntologyClass {class_name: row.class_name}) SET c.description = row.description, c.binding_kind = row.binding_kind,     c.properties = row.properties, c.synonyms = row.synonyms, c.certified = row.certified, c.certified_by = row.certified_by, c.certified_at = row.certified_at CREATE (m)-[:HAS_CLASS]->(c)
