MATCH (m:_OntologyModel)-[:HAS_CLASS]->(c:_OntologyClass)-[:HAS_BINDING]->(:_OntologyBinding)-[:HAS_BEHAVIOR]->(h:_OntologyBehavior) WHERE $schema_name IS NULL OR m.name = $schema_name RETURN m.name AS schema_name, c.class_name AS class_name,        h.behavior_name AS name, h.description AS description,        h.golden_question AS golden_question, h.behavior_type AS behavior_type,        h.synonyms AS synonyms, h.certified AS certified, h.certified_by AS certified_by
