MATCH (m:_OntologyModel)-[:HAS_CLASS]->(c:_OntologyClass) WHERE $schema_name IS NULL OR m.name = $schema_name OPTIONAL MATCH (c)-[:HAS_BINDING]->(b:_OntologyBinding) RETURN m.name AS schema_name, c.class_name AS class_name,        c.description AS description, c.binding_kind AS binding_kind,        c.properties AS properties, b.column_map AS column_map,        b.key_columns AS key_columns, b.label_property AS label_property,        b.virtual_node AS virtual_node,        c.synonyms AS synonyms, c.certified AS certified, c.certified_by AS certified_by
