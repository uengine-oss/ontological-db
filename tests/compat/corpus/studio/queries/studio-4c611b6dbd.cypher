MATCH (m:_OntologyModel)-[:HAS_CLASS]->(c:_OntologyClass {class_name: $class_name}) -[:HAS_BINDING]->(b:_OntologyBinding) WHERE $schema_name IS NULL OR m.name = $schema_name OPTIONAL MATCH (b)-[:HAS_BEHAVIOR]->(h:_OntologyBehavior) RETURN c.class_name AS class_name, c.description AS description,        b.datasource AS datasource, b.source_schema AS source_schema,        b.table_name AS table_name, b.extra_tables AS extra_tables,        b.key_columns AS key_columns, b.column_map AS column_map,        b.base_conditions AS base_conditions, b.label_property AS label_property,        b.default_limit AS default_limit,        collect({name: h.behavior_name, description: h.description,                 parameters: h.parameters, sql_template: h.sql_template,                 output_columns: h.output_columns, result_kind: h.result_kind,                 max_rows: h.max_rows, golden_question: h.golden_question,                 behavior_type: h.behavior_type, certified: h.certified}) AS behaviors
