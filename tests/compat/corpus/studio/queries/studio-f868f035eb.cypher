MATCH (m:_OntologyModel)-[:HAS_CLASS]->(c:_OntologyClass {class_name: $class_name})-[:HAS_BINDING]->(:_OntologyBinding)-[:HAS_BEHAVIOR]->(h:_OntologyBehavior {behavior_name: $behavior_name}) WHERE $schema_name IS NULL OR m.name = $schema_name RETURN m.name AS schema_name, h.behavior_name AS name, h.description AS description,        h.behavior_type AS behavior_type, h.parameters AS parameters,        h.cypher_template AS cypher_template, h.sql_template AS sql_template,        h.output_columns AS output_columns, h.result_kind AS result_kind,        h.max_rows AS max_rows, h.golden_question AS golden_question,        h.certified AS certified, h.certified_by AS certified_by, h.synonyms AS synonyms
