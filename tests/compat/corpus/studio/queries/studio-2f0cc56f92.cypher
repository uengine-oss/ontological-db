MATCH (m:_OntologyModel {schema_id: $schema_id}) UNWIND $rows AS row CREATE (r:_OntologyRelationship {name: row.name}) SET r.from_class = row.from_class, r.to_class = row.to_class,     r.description = row.description, r.properties = row.properties, r.synonyms = row.synonyms, r.certified = row.certified, r.certified_by = row.certified_by, r.certified_at = row.certified_at CREATE (m)-[:HAS_RELATIONSHIP]->(r)
