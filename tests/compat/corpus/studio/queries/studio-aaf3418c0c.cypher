UNWIND $rows AS row MATCH (m:_OntologyModel {schema_id: $schema_id})-[:HAS_CLASS]->(c:_OntologyClass {class_name: row.class_name}) CREATE (b:_OntologyBinding {class_name: row.class_name}) SET b.datasource = row.datasource, b.source_schema = row.source_schema,     b.table_name = row.table_name, b.extra_tables = row.extra_tables,     b.key_columns = row.key_columns, b.column_map = row.column_map,     b.base_conditions = row.base_conditions, b.label_property = row.label_property,     b.default_limit = row.default_limit, b.virtual_node = row.virtual_node CREATE (c)-[:HAS_BINDING]->(b)
